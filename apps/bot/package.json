{
  "name": "@navbat/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/bot.js",
  "types": "dist/bot.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bot.d.ts",
      "import": "./dist/bot.js",
      "default": "./dist/bot.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@navbat/shared": "*",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
