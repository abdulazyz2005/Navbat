# ============================================================================
# NAVBAT — muhit o'zgaruvchilari
# Nusxa oling:  cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------- MAJBURIY

# PostgreSQL. Railwayda Postgres qo'shsangiz avtomatik beriladi.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navbat?schema=public"

# @BotFather → /newbot → olingan token.
# HECH QACHON frontendga chiqmaydi (VITE_ prefiksi yo'q).
TELEGRAM_BOT_TOKEN=""

# Sessiya tokenlarini imzolash kaliti. Yarating:  openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"


# --------------------------------------------------- BITTA SERVIS (production)
# API + Mini App + bot bitta processda ishlaydi.

# Servisning public HTTPS manzili.
# Railway: Settings → Networking → Generate Domain, so'ng shu manzilni yozing.
# (Railwayda PUBLIC_URL bo'sh qoldirilsa, RAILWAY_PUBLIC_DOMAIN dan olinadi.)
PUBLIC_URL=""

# Telegram webhookni himoyalash uchun maxfiy so'z. Yarating:  openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=""

# Bot qaysi rejimda ishlasin: webhook | polling | off
#   webhook — production (PUBLIC_URL va TELEGRAM_WEBHOOK_SECRET kerak)
#   polling — lokal dev (alohida `npm run dev:bot` processi)
#   off     — bot bu processda ishlamaydi
# Bo'sh qoldirilsa: productionda webhook, devda off.
BOT_MODE=""

# Qurilgan Mini App fayllarini API bersinmi?
# Bo'sh qoldirilsa: productionda true, devda false (Vite beradi).
SERVE_WEB=""


# -------------------------------------------------------------------- API
PORT=3001
SESSION_TTL_SEC=604800

# DIQQAT: NODE_ENV ni bu faylga YOZMANG.
# Vite uni build paytida ham o'qiydi va `development` bo'lsa React'ning
# development versiyasi bundlega tushadi (hajm 2x, so'rovlar 2x).
# NODE_ENV ni host beradi: Railway/Docker → production, lokal dev → standart.
INIT_DATA_MAX_AGE_SEC=86400

# Mini App manzili. Bo'sh qoldirilsa PUBLIC_URL ishlatiladi.
# Alohida frontend hosting bo'lsa (Vercel), shu yerga uning manzilini yozing.
WEB_APP_URL=""

# CORS. Bitta servis rejimida PUBLIC_URL avtomatik qo'shiladi.
CORS_ORIGINS="http://localhost:5173"


# ----------------------------------------------------------------- BIZNES
PLATFORM_FEE_PERCENT=10
MIN_ORDER_AMOUNT=10000
MIN_WITHDRAWAL_AMOUNT=50000
CHECKIN_RADIUS_M=500


# ----------------------------------------------------------------- TO'LOV
# mock — MVP simulyatsiyasi. Real provayder ulanganda: click | payme
PAYMENT_PROVIDER="mock"
# CLICK_MERCHANT_ID=""
# CLICK_SECRET=""
# PAYME_MERCHANT_ID=""
# PAYME_KEY=""


# ----------------------------------------------------------------- ADMIN
# O'z Telegram ID'ingiz. Olish: @userinfobot ga /start yuboring.
# Vergul bilan bir nechta admin: "123456789,987654321"
ADMIN_TELEGRAM_IDS=""


# ------------------------------------------------------------ LOKAL DEV
# Frontend qaysi API'ga ulansin. Bitta servis rejimida BO'SH qoldiring —
# so'rovlar bir originning /api yo'liga ketadi.
VITE_API_URL=""

# FAQAT lokal test: Telegramsiz, brauzerda ochish uchun initData imzosini
# tekshirmaslik. Productionda hech qachon true qilmang (NODE_ENV=production
# bo'lganda avtomatik o'chadi).
ALLOW_INSECURE_AUTH=false
# ALLOW_INSECURE_AUTH=true bo'lganda qaysi seed foydalanuvchi sifatida kirish:
#   100000001 = Abdulaziz (admin, buyurtmachi+navbatchi)
#   100000006 = Ali (navbatchi)
VITE_DEV_TELEGRAM_ID=""
VITE_DEV_TELEGRAM_NAME=""
